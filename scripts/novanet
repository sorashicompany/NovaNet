#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/novanet"
PROFILES="$CONFIG_DIR/profiles"
mkdir -p "$PROFILES"
engine="${NOVANET_ENGINE:-novanet-engine}"
usage(){ cat <<'EOF'
NovaNet Termux

  profile import <wdtt://...|qwdtt://...|json>
  profile list
  profile remove <name>
  connect --profile <name> [engine flags...]
  ping --profile <name>
  check --profile <name>
  subscription sync [URL]
EOF
}
profile_file(){ printf '%s/%s.json' "$PROFILES" "$1"; }
import_profile(){
  local raw="${1:-}"; [ -n "$raw" ] || { echo 'profile value required'; exit 2; }
  python - "$raw" "$PROFILES" <<'PY'
import json, os, sys, urllib.parse
raw, root = sys.argv[1], sys.argv[2]
if raw.startswith('wdtt://'):
    p=raw[len('wdtt://'):].split(':')
    if len(p)<6: raise SystemExit('invalid wdtt:// profile')
    obj={'name':'NovaNet-'+p[0].replace('.','-'),'peer':p[0]+':'+p[1],'port':int(p[3] or 9000),'password':p[4],'hashes':':'.join(p[5:]),'workers':16,'source':raw}
elif raw.startswith('qwdtt://'):
    u=urllib.parse.urlparse(raw); q=urllib.parse.parse_qs(u.query)
    obj={'name':q.get('name',['NovaNet'])[0],'peer':q.get('peer',[''])[0],'port':int(q.get('port',['9000'])[0]),'password':q.get('pass',[''])[0],'hashes':q.get('hashes',[''])[0],'workers':int(q.get('workers',['16'])[0]),'source':raw}
else: obj=json.loads(raw)
if not obj.get('peer') or not obj.get('password') or not obj.get('hashes'): raise SystemExit('peer/password/hashes are required')
name=''.join(c if c.isalnum() or c in '._-' else '_' for c in obj.get('name','profile')).strip('_') or 'profile'
obj['name']=name; os.makedirs(root,exist_ok=True)
with open(os.path.join(root,name+'.json'),'w',encoding='utf-8') as f: json.dump(obj,f,ensure_ascii=False,indent=2)
print(name)
PY
}
get_profile(){ python - "$PROFILES/$(basename "$1").json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1])); print(p['peer'],p['hashes'],p.get('workers',16),p.get('port',9000),p['password'])
PY
}
case "${1:-}" in
profile)
  case "${2:-}" in
    import) import_profile "${3:-}";;
    list) ls "$PROFILES"/*.json 2>/dev/null | sed 's#.*/##;s#\.json$##' || true;;
    remove) rm -f "$(profile_file "${3:-}")";;
    *) usage; exit 2;;
  esac;;
connect|ping|check)
  action="$1"; shift; profile=""
  while [ $# -gt 0 ]; do case "$1" in --profile) profile="$2"; shift 2;; *) break;; esac; done
  [ -n "$profile" ] || { echo '--profile is required'; exit 2; }
  read -r peer hashes workers port pass < <(get_profile "$profile")
  if [ "$action" = ping ]; then exec "$engine" -peer "$peer" -vk "$hashes" -password "$pass" -ping-only; fi
  if [ "$action" = check ]; then exec "$engine" -vk "$hashes" -check-hashes; fi
  exec "$engine" -peer "$peer" -vk "$hashes" -password "$pass" -listen "127.0.0.1:$port" -n "$workers" "$@";;
subscription)
  [ "${2:-}" = sync ] || { usage; exit 2; }
  url="${3:-${NOVANET_SUBSCRIPTION_URL:-}}"; [ -n "$url" ] || { echo 'subscription URL required'; exit 2; }
  curl -fsSL "$url" -o "$PROFILES/subscription.json"
  python - "$PROFILES/subscription.json" "$PROFILES" <<'PY'
import json,sys,os
src=json.load(open(sys.argv[1])); profiles=src.get('profiles',src.get('servers',[]))
for p in profiles:
 n=''.join(c if c.isalnum() or c in '._-' else '_' for c in p.get('name','server')).strip('_') or 'server'; p['name']=n
 json.dump(p,open(os.path.join(sys.argv[2],n+'.json'),'w'),ensure_ascii=False,indent=2)
print('synced',len(profiles),'profiles')
PY
  ;;
*) usage; exit 2;;
esac
